# Copy to .env.local and fill in. Every value here is empty on purpose —
# .env.example is committed, .env.local is not.
#
# The app runs with all of these blank. Positions, prices-you-enter-by-hand,
# the rules engine, flags, history and the playbook all work. Each feature
# that needs a key degrades to a visible "not configured" state instead of
# crashing.

# ---------------------------------------------------------------------------
# Market data — primary provider
# ---------------------------------------------------------------------------
# https://finnhub.io/register → free account → Dashboard → API Key.
# Free tier: 60 calls/minute. This app caches for an hour per ticker, so a
# normal week costs a few dozen calls.
FINNHUB_API_KEY=

# ---------------------------------------------------------------------------
# Market data — fallback provider, used only when Finnhub errors
# ---------------------------------------------------------------------------
# https://www.alphavantage.co/support/#api-key → free key, emailed instantly.
# Free tier: 25 calls/day. Too tight to be primary; fine as a backstop.
ALPHA_VANTAGE_API_KEY=

# ---------------------------------------------------------------------------
# Anthropic — weekly brief and gap analysis
# ---------------------------------------------------------------------------
# https://console.anthropic.com → Settings → API Keys → Create Key.
# Without this, the Brief and Gap views show "not configured" and the archive
# still displays every brief already generated.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5.
ANTHROPIC_MODEL=

# Optional. Thinking depth: low | medium | high | xhigh | max. Defaults to max.
ANTHROPIC_EFFORT=

# ---------------------------------------------------------------------------
# Email — weekly brief delivery
# ---------------------------------------------------------------------------
# https://resend.com → sign up → API Keys → Create.
# Without these the brief is still generated, stored, and readable in the app;
# it just is not emailed.
RESEND_API_KEY=

# Must be a domain verified in Resend, or onboarding@resend.dev for testing.
BRIEF_FROM_EMAIL=
# Where the weekly brief is sent.
BRIEF_TO_EMAIL=

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
# Shared secret required by /api/cron/weekly. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Leave blank in local dev to allow unauthenticated calls from localhost.
CRON_SECRET=

# Base URL the dev cron runner posts to. Defaults to http://localhost:3000
APP_URL=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Optional. Defaults to ./data/portfolio.db
DATABASE_PATH=
